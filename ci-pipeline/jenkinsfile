pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'AMI_ID',
            defaultValue: 'ami-0f8a61b66d1accaee',
            description: 'Ubuntu AMI ID in us-east-1'
        )

        string(
            name: 'KEY_NAME',
            defaultValue: 'jenkins_server',
            description: 'Existing AWS EC2 key pair name'
        )

        string(
            name: 'ALLOWED_SSH_CIDR',
            defaultValue: '124.123.192.253/32',
            description: 'Your public IP in CIDR format'
        )
    }

    environment {
        AWS_DEFAULT_REGION    = 'us-east-1'
        AWS_REGION            = 'us-east-1'
        TF_IN_AUTOMATION      = 'true'
        TF_INPUT              = 'false'

        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')

        TF_VAR_ami_id           = "${params.AMI_ID}"
        TF_VAR_key_name         = "${params.KEY_NAME}"
        TF_VAR_allowed_ssh_cidr = "${params.ALLOWED_SSH_CIDR}"
    }

    stages {
        stage('Checkout Repository') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/mudassirkhan07/aws-jenkins.git'
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    set -e
                    terraform version
                    git --version
                    aws --version
                '''
            }
        }

        stage('Terraform Format Check') {
            steps {
                sh 'terraform fmt -check -recursive -no-color'
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform init -input=false -no-color'
            }
        }

        stage('Terraform Validate') {
            steps {
                sh 'terraform validate -no-color'
            }
        }

        stage('Terraform Plan') {
            steps {
                sh '''
                    set -e

                    terraform plan \
                        -input=false \
                        -no-color \
                        -out=tfplan

                    terraform show -no-color tfplan > plan.txt
                '''
            }
        }
    }

    post {
        success {
            // Only the readable plan is archived. tfplan can contain secrets.
            archiveArtifacts(
                artifacts: 'plan.txt',
                fingerprint: true
            )
            echo 'Terraform CI succeeded. No terraform apply was executed.'
        }

        failure {
            echo 'Pipeline failed. Review the failed stage in Console Output.'
        }

        cleanup {
            deleteDir()
        }
    }
}
